{
  "name": "seqno",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "pnpm lint && oxfmt --check && pnpm typecheck && pnpm test",
    "check:fast": "pnpm lint && oxfmt --check && pnpm typecheck && vitest run --changed origin/main",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "typecheck": "pnpm --recursive --workspace-concurrency=2 typecheck",
    "test": "scripts/turn vitest run",
    "build": "pnpm --filter @seqno/site build && pnpm --filter @seqno/web build --base /app/ --outDir ../site/dist/app"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/node": "24.19.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.26.0"
}
