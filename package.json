{
  "name": "seqno",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "check": "pnpm lint && oxfmt --check && pnpm typecheck && pnpm test",
    "check:fast": "pnpm lint && oxfmt --check && pnpm typecheck && vitest run --maxWorkers=2 --changed origin/main",
    "lint": "oxlint --deny-warnings",
    "typecheck": "pnpm --recursive --workspace-concurrency=2 typecheck",
    "test": "scripts/turn vitest run --maxWorkers=2",
    "build": "pnpm --filter @seqno/site build && pnpm --filter @seqno/web build --base /app/ --outDir ../site/dist/app",
    "fix": "oxlint --fix; oxfmt"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/node": "24.19.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.26.0"
}
