{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @seqno/web exec vite build --base /app/ --outDir dist/app",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "seqno-app.vercel.app" }],
      "missing": [{ "type": "header", "key": "x-forwarded-host", "value": "seqno.vercel.app" }],
      "destination": "https://seqno.vercel.app/app/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/app/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/app/lsp/(.*)",
      "destination": "https://pub-80f42b85b62c40219354a834fcf2bbfa.r2.dev/$1"
    },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ]
}
