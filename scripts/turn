#!/bin/sh
set -e
lock=/tmp/seqno-turn.lock
if ! command -v flock >/dev/null; then exec "$@"; fi
if systemctl --user cat seqno.slice >/dev/null 2>&1; then
  set -- systemd-run --user --scope --quiet --slice=seqno.slice -p CPUWeight=10 nice -n 19 "$@"
fi
flock -n "$lock" true || echo "scripts/turn: waiting for another seqno run on this machine to finish" >&2
exec flock -o "$lock" "$@"
